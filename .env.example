# Express API that /api/* is proxied to (see next.config.js)
BACKEND_URL=http://localhost:4000
# Browser-side API base; keep "/api" so requests go through the Next.js proxy
NEXT_PUBLIC_API_URL=/api
# Socket.IO connects to the backend directly (WebSockets can't go through the proxy)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
